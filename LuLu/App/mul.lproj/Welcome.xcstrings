    "r1b-Nl-Ii7.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Outgoing connections from Apple-signed programs will be allowed.\"; ObjectID = \"r1b-Nl-Ii7\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgehende Verbindungen von Apple-signierten Programmen werden erlaubt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Outgoing connections from Apple-signed programs will be allowed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se permitirán las conexiones salientes de los programas firmados por Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les connexions sortantes des programmes signés par Apple seront autorisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le connessioni in uscita dai programmi firmati da Apple saranno consentite."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple이 서명한 프로그램의 나가는 연결이 허용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenia wychodzące z programów podpisanych przez Apple będą dozwolone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexões de saída de programas assinados pela Apple serão permitidas."
