    "NCu-fH-K04.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"These can be changed later, via LuLu's Settings.\"; ObjectID = \"NCu-fH-K04\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese können später in den LuLu-Einstellungen geändert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These can be changed later, via LuLu's Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto se puede cambiar más tarde en los ajustes de LuLu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces réglages peuvent être modifiés ultérieurement dans les réglages de LuLu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste impostazioni possono essere modificate in seguito nelle impostazioni di LuLu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정은 나중에 LuLu 설정에서 변경할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Można to zmienić później w ustawieniach programu LuLu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso pode ser alterado depois, nos ajustes do LuLu."
