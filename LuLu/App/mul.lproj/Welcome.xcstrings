    "sAE-Mf-3fz.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"All outgoing UDP traffic on port 53 will be allowed.\"; ObjectID = \"sAE-Mf-3fz\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sämtlicher ausgehender UDP-Verkehr auf Port 53 wird erlaubt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All outgoing UDP traffic on port 53 will be allowed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se permitirá todo el tráfico UDP saliente en el puerto 53."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le trafic UDP sortant sur le port 53 sera autorisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il traffico UDP in uscita sulla porta 53 sarà consentito."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포트 53의 모든 나가는 UDP 트래픽이 허용됩니다."
