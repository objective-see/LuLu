{
  "sourceLanguage" : "en",
  "strings" : {
    "3aO-AI-YtY.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Outgoing connections from currently installed 3rd-party programs will be allowed.\"; ObjectID = \"3aO-AI-YtY\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgehende Verbindungen von bereits installierten Drittanbieter-Programmen werden erlaubt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Outgoing connections from currently installed 3rd-party programs will be allowed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se permitirán las conexiones salientes de los programas de terceros ya instalados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les connexions sortantes des programmes tiers déjà installés seront autorisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le connessioni in uscita dai programmi di terze parti già installati saranno consentite."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 설치된 타사 프로그램의 나가는 연결이 허용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wychodzące połączenia z aktualnie zainstalowanych programów firm trzecich będą dozwolone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexões de saída de programas de terceiros já instalados serão permitidas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anda kurulu olan başka 3. kişilerin programlarından giden trafiğe izin verilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вихідні з’єднання від уже встановлених сторонніх програм будуть дозволені."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے سے انسٹال شدہ تھرڈ پارٹی پروگراموں کے کنکشنز کی اجازت ہوگی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将允许当前已安装的第三方程序的传出连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將允許目前已安裝的第三方程式的傳出連線。"
          }
        }
      }
    },
    "7pD-BH-c8i.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Mahalo to the \\\"Friends Objective-See\\\"\"; ObjectID = \"7pD-BH-c8i\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahalo an die \"Friends Objective-See\""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mahalo to the \"Friends Objective-See\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias a los \"Friends of Objective-See\""
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahalo aux « Amis Objectif-See »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie agli \"Amici di Objective-See\""
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Objective-See 친구들\"에게, 마할로!"
          }
