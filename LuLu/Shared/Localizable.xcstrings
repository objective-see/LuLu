    "All outgoing UDP traffic on port 53 will be allowed." : {
      "comment" : "All outgoing UDP traffic on port 53 will be allowed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sämtlicher ausgehender UDP-Verkehr auf Port 53 wird erlaubt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα επιτρέπεται όλη η εξερχόμενη κίνηση UDP στη θύρα 53."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se permitirá todo el tráfico UDP saliente en el puerto 53."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le trafic UDP sortant sur le port 53 sera autorisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il traffico UDP in uscita sulla porta 53 sarà consentito."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포트 53의 모든 나가는 UDP 트래픽이 허용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cały wychodzący ruch UDP na porcie 53 będzie dozwolony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo o tráfego UDP de saída na porta 53 será permitido."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "53. kapıdaki tüm (UDP) giden trafiğine izin verilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увесь вихідний UDP-трафік на порту 53 буде дозволено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پورٹ 53 پر تمام باہر جانے والی UDP ٹریفک کی اجازت ہوگی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将允许端口 53 上的所有传出 UDP 流量。"
          }
