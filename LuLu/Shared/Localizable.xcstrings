    "Allow or block by program, endpoint or domain; temporarily, or for good." : {
      "comment" : "Allow or block by program, endpoint or domain; temporarily, or for good.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube oder blockiere nach Programm, Endpunkt oder Domain – vorübergehend oder dauerhaft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίτρεψε ή απόκλεισε ανά πρόγραμμα, τελικό σημείο ή domain· προσωρινά ή μόνιμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite o bloquea por programa, destino o dominio; de forma temporal o permanente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez ou bloquez par programme, destination ou domaine ; temporairement ou définitivement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti o blocca per programma, endpoint o dominio; temporaneamente o per sempre."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로그램, 엔드포인트 또는 도메인별로 허용하거나 차단하세요. 일시적으로, 또는 영구적으로."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwalaj lub blokuj według programu, punktu końcowego lub domeny; tymczasowo lub na stałe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita ou bloqueie por programa, destino ou domínio; temporariamente ou para sempre."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programa, uç noktaya veya alan adına göre izin ver ya da engelle; geçici veya kalıcı olarak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяй або блокуй за програмою, кінцевою точкою чи доменом; тимчасово або назавжди."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروگرام، اینڈ پوائنٹ یا ڈومین کے لحاظ سے اجازت دیں یا بلاک کریں؛ عارضی طور پر یا مستقل۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按程序、端点或域名允许或阻止；临时或永久。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按程式、端點或網域允許或封鎖；暫時或永久。"
          }
        }
      }
    },
    "Approve “LuLu” under Network Extensions, then come back." : {
