    "LuLu could not communicate with its system extension. A reboot might fix this!" : {
      "comment" : "LuLu could not communicate with its system extension. A reboot might fix this!",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu konnte nicht mit seiner Systemerweiterung kommunizieren. Ein Neustart könnte das beheben!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το LuLu δεν μπόρεσε να επικοινωνήσει με την επέκταση συστήματος. Μια επανεκκίνηση του Mac ίσως διορθώσει το πρόβλημα!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu no pudo comunicarse con su extensión del sistema. ¡Reiniciar podría solucionarlo!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu n’a pas pu communiquer avec son extension système. Un redémarrage pourrait résoudre le problème !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu non è riuscito a comunicare con la sua estensione di sistema. Un riavvio potrebbe risolvere il problema!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu가 시스템 확장 프로그램과 통신할 수 없습니다. 재부팅하면 해결될 수 있습니다!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu nie mógł połączyć się ze swoim rozszerzeniem systemowym. Ponowne uruchomienie może to naprawić!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LuLu não conseguiu se comunicar com sua extensão de sistema. Reiniciar pode resolver isso!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
