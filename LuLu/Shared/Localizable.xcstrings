    "%@ no longer exists, so its rule cannot be edited. The rule can still be disabled or deleted." : {
      "comment" : "%@ no longer exists, so its rule cannot be edited. The rule can still be disabled or deleted.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ existiert nicht mehr, daher kann die Regel nicht bearbeitet werden. Sie kann aber weiterhin deaktiviert oder gelöscht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ δεν υπάρχει πλέον, επομένως ο κανόνας του δεν μπορεί να επεξεργαστεί. Ο κανόνας μπορεί ακόμη να απενεργοποιηθεί ή να διαγραφεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no existe, por lo que su regla no puede editarse. La regla aún puede desactivarse o eliminarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’existe plus, sa règle ne peut donc pas être modifiée. Elle peut toujours être désactivée ou supprimée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non esiste più, quindi la sua regola non può essere modificata. La regola può comunque essere disattivata o eliminata."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 더 이상 존재하지 않아 규칙을 편집할 수 없습니다. 규칙은 여전히 비활성화하거나 삭제할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ już nie istnieje, więc nie można edytować jego reguły. Regułę nadal można wyłączyć lub usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não existe mais, portanto sua regra não pode ser editada. A regra ainda pode ser desativada ou excluída."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ artık mevcut değil, bu yüzden kuralı düzenlenemiyor. Kural yine de devre dışı bırakılabilir veya silinebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ більше не існує, тому його правило не можна змінити. Правило все ще можна вимкнути або видалити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ اب موجود نہیں ہے، اس لیے اس کا قاعدہ ترمیم نہیں کیا جا سکتا۔ قاعدے کو اب بھی غیر فعال یا حذف کیا جا سکتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已不存在，因此无法编辑其规则。该规则仍可被禁用或删除。"
          }
