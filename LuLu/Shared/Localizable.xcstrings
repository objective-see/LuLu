        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...이 작업은 사용자의 Mac에서 LuLu를 완전히 삭제합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "...spowoduje to całkowite usunięcie LuLu z Twojego Maca"
