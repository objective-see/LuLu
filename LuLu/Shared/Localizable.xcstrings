        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…isto vai remover LuLu completamente do seu Mac"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…bu, LuLu’yu Mac’inizden tümüyle kaldıracaktır"
