        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…αυτό θα τερματίσει το LuLu μέχρι την επόμενη σύνδεσή σας."
          }
        },
        "es" : {
          "stringUnit" : {
