    "When a program first tries to connect out, LuLu asks you to allow or block it." : {
      "comment" : "When a program first tries to connect out, LuLu asks you to allow or block it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein Programm zum ersten Mal eine Verbindung nach außen aufbaut, fragt LuLu, ob du sie erlauben oder blockieren willst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν ένα πρόγραμμα προσπαθήσει για πρώτη φορά να συνδεθεί, το LuLu σε ρωτά αν θα το επιτρέψεις ή θα το αποκλείσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando un programa intenta conectarse por primera vez, LuLu te pregunta si permitirlo o bloquearlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu’un programme tente pour la première fois de se connecter, LuLu vous demande de l’autoriser ou de le bloquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando un programma tenta per la prima volta di connettersi, LuLu ti chiede se consentirlo o bloccarlo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로그램이 처음 외부 연결을 시도하면 LuLu가 허용할지 차단할지 물어봅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy program po raz pierwszy próbuje nawiązać połączenie, LuLu pyta, czy je zezwolić, czy zablokować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando um programa tenta se conectar pela primeira vez, o LuLu pergunta se deseja permitir ou bloquear."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir program ilk kez dışarı bağlanmaya çalıştığında LuLu izin vermenizi veya engellemenizi ister."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли програма вперше намагається встановити з’єднання, LuLu запитує, дозволити її чи заблокувати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب کوئی پروگرام پہلی بار باہر کنکشن کی کوشش کرتا ہے، LuLu آپ سے اجازت دینے یا بلاک کرنے کا پوچھتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当程序首次尝试向外连接时，LuLu 会询问你允许还是阻止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當程式首次嘗試對外連線時，LuLu 會詢問你允許還是封鎖。"
          }
        }
      }
    }
